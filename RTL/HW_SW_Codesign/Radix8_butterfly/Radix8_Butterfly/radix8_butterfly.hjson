      "desc": "Output data 5 (o_data5)",
      "swaccess": "ro",
      "hwaccess": "hwo",
      "hwext": "true",
      "fields": [ { "bits": "31:0", "name": "VAL", "desc": "Packed Real/Imag (latched)" } ]
    },
    {
      "name": "OUT6",
      "desc": "Output data 6 (o_data6)",
      "swaccess": "ro",
      "hwaccess": "hwo",
      "hwext": "true",
      "fields": [ { "bits": "31:0", "name": "VAL", "desc": "Packed Real/Imag (latched)" } ]
    },
    {
      "name": "OUT7",
      "desc": "Output data 7 (o_data7)",
      "swaccess": "ro",
      "hwaccess": "hwo",
      "hwext": "true",
      "fields": [ { "bits": "31:0", "name": "VAL", "desc": "Packed Real/Imag (latched)" } ]
    }
  ]
