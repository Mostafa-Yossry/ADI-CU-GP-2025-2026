<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="800" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="node_sys" value="Received Signal Model&lt;br&gt;&lt;b style=&#34;font-size:16px;&#34;&gt;&lt;i&gt;Y = HX + N&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="40" width="240" height="60" as="geometry" />
    </mxCell>

    <mxCell id="node_mf" value="Hermitian Transpose Multiplication&lt;br&gt;&lt;i style=&#34;font-size:12px;&#34;&gt;(Matched Filtering)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="140" width="240" height="50" as="geometry" />
    </mxCell>

    <mxCell id="node_norm" value="Normal Equations&lt;br&gt;&lt;b style=&#34;font-size:16px;&#34;&gt;&lt;i&gt;H&lt;sup&gt;H&lt;/sup&gt;Y = H&lt;sup&gt;H&lt;/sup&gt;HX + H&lt;sup&gt;H&lt;/sup&gt;N&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="230" width="300" height="60" as="geometry" />
    </mxCell>

    <mxCell id="node_sub" value="Variable Substitution&lt;br&gt;Gram Matrix: &lt;b&gt;&lt;i&gt;A = H&lt;sup&gt;H&lt;/sup&gt;H&lt;/i&gt;&lt;/b&gt;&lt;br&gt;Matched Vector: &lt;b&gt;&lt;i&gt;b = H&lt;sup&gt;H&lt;/sup&gt;Y&lt;/i&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="330" width="240" height="70" as="geometry" />
    </mxCell>

    <mxCell id="node_lin" value="Equivalent Linear System&lt;br&gt;&lt;b style=&#34;font-size:18px;&#34;&gt;&lt;i&gt;AX = b&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="280" y="440" width="240" height="70" as="geometry" />
    </mxCell>

    <mxCell id="node_inv" value="Explicit Matrix Inversion&lt;br&gt;&lt;b style=&#34;font-size:16px;&#34;&gt;&lt;i&gt;X = A&lt;sup&gt;-1&lt;/sup&gt;b&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#34;font-size:11px;font-style:italic;&#34;&gt;(High Complexity / Avoided)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;strokeWidth=2;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="120" y="570" width="220" height="90" as="geometry" />
    </mxCell>

    <mxCell id="node_chol" value="Matrix Factorization&lt;br&gt;&lt;b style=&#34;font-size:16px;&#34;&gt;Cholesky Decomposition&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#34;font-size:11px;font-style:italic;&#34;&gt;(Hardware Friendly / Adopted)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="460" y="570" width="220" height="90" as="geometry" />
    </mxCell>

    <mxCell id="edge_1" value=" Multiply by &lt;b&gt;&lt;i&gt;H&lt;sup&gt;H&lt;/sup&gt;&lt;/i&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#000000;endArrow=classic;align=left;fontSize=12;" edge="1" parent="1" source="node_sys" target="node_mf">
      <mxGeometry x="0.2" y="20" relative="1" as="geometry">
        <mxPoint as="offset" />
      </mxGeometry>
    </mxCell>

    <mxCell id="edge_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#000000;endArrow=classic;" edge="1" parent="1" source="node_mf" target="node_norm">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#000000;endArrow=classic;" edge="1" parent="1" source="node_norm" target="node_sub">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#000000;endArrow=classic;" edge="1" parent="1" source="node_sub" target="node_lin">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="edge_5_inv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;strokeColor=#666666;endArrow=classic;dashed=1;" edge="1" parent="1" source="node_lin" target="node_inv">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="400" y="540" />
          <mxPoint x="230" y="540" />
        </Array>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="edge_5_chol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#000000;endArrow=classic;" edge="1" parent="1" source="node_lin" target="node_chol">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="400" y="540" />
          <mxPoint x="570" y="540" />
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>